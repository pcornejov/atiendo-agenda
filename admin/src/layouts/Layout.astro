---
import { env } from "cloudflare:workers";
import { listarCodigosModulosActivos, type Usuario } from "../lib/db.ts";

interface Props {
  title: string;
}
const { title } = Astro.props;
const usuario: Usuario | undefined = Astro.locals.usuario;
const modulosActivos =
  usuario?.rol === "dueno" && usuario.negocio_id
    ? await listarCodigosModulosActivos(env.DB, usuario.negocio_id)
    : [];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Atiendo Agenda</title>
    <style>
      :root {
        color-scheme: light dark;

        --paper: #eee9e0;
        --surface: #f7f4ee;
        --ink: #26221d;
        --ink-muted: #6b6459;
        --line: #d9d2c5;
        --accent: #b8721e;
        --accent-ink: #ffffff;
        --success: #3d7a4f;
        --success-bg: #e3ede2;
        --critical: #a8402f;
        --critical-bg: #f3e1dc;
        --shadow: 0 1px 2px rgba(38, 34, 29, 0.07), 0 1px 1px rgba(38, 34, 29, 0.04);

        --font-display: ui-serif, Georgia, "Iowan Old Style", "Palatino Linotype", "Noto Serif", serif;
        --font-body: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #1b1815;
          --surface: #242019;
          --ink: #ede7dc;
          --ink-muted: #a69d8c;
          --line: #3a342c;
          --accent: #e0a64b;
          --accent-ink: #221a0d;
          --success: #6fae7c;
          --success-bg: #26332a;
          --critical: #e1786a;
          --critical-bg: #3a2620;
          --shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 1px 1px rgba(0, 0, 0, 0.2);
        }
      }

      :root[data-theme="dark"] {
        --paper: #1b1815;
        --surface: #242019;
        --ink: #ede7dc;
        --ink-muted: #a69d8c;
        --line: #3a342c;
        --accent: #e0a64b;
        --accent-ink: #221a0d;
        --success: #6fae7c;
        --success-bg: #26332a;
        --critical: #e1786a;
        --critical-bg: #3a2620;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 1px 1px rgba(0, 0, 0, 0.2);
      }

      :root[data-theme="light"] {
        --paper: #eee9e0;
        --surface: #f7f4ee;
        --ink: #26221d;
        --ink-muted: #6b6459;
        --line: #d9d2c5;
        --accent: #b8721e;
        --accent-ink: #ffffff;
        --success: #3d7a4f;
        --success-bg: #e3ede2;
        --critical: #a8402f;
        --critical-bg: #f3e1dc;
        --shadow: 0 1px 2px rgba(38, 34, 29, 0.07), 0 1px 1px rgba(38, 34, 29, 0.04);
      }

      * {
        box-sizing: border-box;
      }

      html {
        overflow-x: hidden;
      }

      body {
        max-width: 840px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-body);
        line-height: 1.55;
        font-size: 16px;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        text-wrap: balance;
        line-height: 1.2;
        color: var(--ink);
      }
      h1 {
        font-size: 1.75rem;
        margin: 0 0 1.25rem;
      }
      h2 {
        font-size: 1.15rem;
        margin: 2rem 0 0.75rem;
      }

      p {
        max-width: 65ch;
      }

      a {
        color: var(--accent);
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--line);
      }
      nav .enlaces {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 1.25rem;
      }
      nav a {
        text-decoration: none;
        font-weight: 600;
        color: var(--ink);
        border-bottom: 2px solid transparent;
        padding-bottom: 2px;
      }
      nav a:hover,
      nav a:focus-visible {
        border-color: var(--accent);
      }
      nav .sesion {
        font-weight: normal;
        font-size: 0.85rem;
        color: var(--ink-muted);
        display: flex;
        gap: 0.75rem;
        align-items: center;
      }
      nav .sesion a {
        color: var(--ink-muted);
        font-weight: 600;
      }

      table {
        display: block;
        overflow-x: auto;
        max-width: 100%;
        width: 100%;
        border-collapse: collapse;
        margin: 1rem 0;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 8px;
      }
      th,
      td {
        text-align: left;
        padding: 0.65rem 0.85rem;
        border-bottom: 1px solid var(--line);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }
      th {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--ink-muted);
        font-weight: 600;
      }
      tbody tr:last-child td {
        border-bottom: none;
      }
      tbody tr:hover {
        background: color-mix(in srgb, var(--accent) 6%, transparent);
      }

      form.inline {
        display: inline;
      }

      .form-grid {
        display: grid;
        gap: 1rem;
        max-width: 480px;
      }
      .form-grid label {
        display: grid;
        gap: 0.35rem;
        font-weight: 600;
        font-size: 0.9rem;
      }

      input,
      select,
      textarea {
        padding: 0.55rem 0.7rem;
        font-size: 1rem;
        font-family: var(--font-body);
        border: 1px solid var(--line);
        border-radius: 6px;
        background: var(--surface);
        color: var(--ink);
      }

      input:focus-visible,
      select:focus-visible,
      textarea:focus-visible,
      button:focus-visible,
      a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      button {
        padding: 0.6rem 1.1rem;
        font-size: 0.95rem;
        font-weight: 600;
        font-family: var(--font-body);
        cursor: pointer;
        border-radius: 6px;
        border: 1px solid var(--accent);
        background: var(--accent);
        color: var(--accent-ink);
        transition: opacity 0.15s ease;
      }
      button:hover {
        opacity: 0.88;
      }
      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      /* Botones de acciones secundarias/menores (fila de tabla: eliminar, activar/
         desactivar, cancelar) — cualquier <button> dentro de form.inline, o con la
         clase .boton-secundario para casos fuera de una tabla (ej. "Descartar"). */
      form.inline button,
      .boton-secundario {
        background: transparent;
        color: var(--ink);
        border: 1px solid var(--line);
      }
      form.inline button:hover,
      .boton-secundario:hover {
        background: var(--surface);
        opacity: 1;
        border-color: var(--ink-muted);
      }

      .error {
        background: var(--critical-bg);
        color: var(--critical);
        padding: 0.85rem 1rem;
        border-radius: 6px;
        margin-bottom: 1.25rem;
        border: 1px solid color-mix(in srgb, var(--critical) 35%, transparent);
      }
      .error ul {
        margin: 0;
        padding-left: 1.2rem;
      }

      .badge,
      .badge-inactivo {
        display: inline-flex;
        align-items: center;
        padding: 0.15em 0.65em;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        white-space: nowrap;
      }
      .badge-success {
        background: var(--success-bg);
        color: var(--success);
      }
      .badge-critical,
      .badge-inactivo {
        background: var(--critical-bg);
        color: var(--critical);
      }
      .badge-neutral {
        background: var(--paper);
        color: var(--ink-muted);
        border: 1px solid var(--line);
      }
    </style>
  </head>
  <body>
    <nav>
      <span class="enlaces">
        {usuario?.rol === "admin" && <a href="/admin/negocios">Negocios</a>}
        {usuario?.rol === "dueno" && usuario.negocio_id && (
          <>
            <a href={`/negocios/${usuario.negocio_id}/editar`}>Mi negocio</a>
            <a href={`/negocios/${usuario.negocio_id}/horarios`}>Horarios</a>
            <a href={`/negocios/${usuario.negocio_id}/citas`}>Citas</a>
            {modulosActivos.includes("pedidos") && (
              <>
                <a href={`/negocios/${usuario.negocio_id}/menu`}>Menú</a>
                <a href={`/negocios/${usuario.negocio_id}/pedidos`}>Pedidos</a>
              </>
            )}
          </>
        )}
      </span>
      {usuario && (
        <span class="sesion">
          {usuario.email}
          <a href="/auth/logout">Salir</a>
        </span>
      )}
    </nav>
    <h1>{title}</h1>
    <slot />
  </body>
</html>
