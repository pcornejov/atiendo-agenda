---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  paso: 1 | 2 | 3 | 4;
}
const { title, paso } = Astro.props;
const NOMBRES_PASO = ["Negocio", "Horarios", "Menú", "Listo"];
---

<Layout title={title}>
  <ol class="wizard-pasos">
    {NOMBRES_PASO.map((nombre, i) => (
      <li class:list={{ actual: i + 1 === paso, hecho: i + 1 < paso }}>
        <span class="numero">{i + 1 < paso ? "✓" : i + 1}</span> {nombre}
      </li>
    ))}
  </ol>
  <slot />
</Layout>

<style>
  .wizard-pasos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }
  .wizard-pasos li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-muted);
    font-size: 0.85rem;
  }
  .wizard-pasos li.hecho {
    color: var(--ink);
  }
  .wizard-pasos li.actual {
    color: var(--ink);
    font-weight: 600;
  }
  .numero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.7em;
    height: 1.7em;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    font-size: 0.8em;
    font-variant-numeric: tabular-nums;
  }
  .wizard-pasos li.hecho .numero {
    border-color: var(--success);
    color: var(--success);
  }
  .wizard-pasos li.actual .numero {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }
</style>
