---
import { env } from "cloudflare:workers";
import WizardLayout from "../../layouts/WizardLayout.astro";
import { obtenerNegocio, listarMenu, crearMenuItem } from "../../lib/db.ts";

const usuario = Astro.locals.usuario;
if (!usuario || usuario.rol !== "dueno" || !usuario.negocio_id) {
  return Astro.redirect(usuario?.rol === "admin" ? "/admin/negocios" : "/onboarding");
}
const negocioId = usuario.negocio_id;
const negocio = await obtenerNegocio(env.DB, negocioId);
if (!negocio) return Astro.redirect("/onboarding");

const ERRORES_SUBIDA: Record<string, string> = {
  sin_archivos: "No se recibió ningún archivo.",
  archivos_muy_grandes: "Los archivos son muy pesados en conjunto (máximo 15MB en total). Prueba con menos fotos o de menor resolución.",
  formato_no_soportado: "El formato del archivo no es compatible — solo fotos (JPG, PNG, GIF, WEBP), PDF o Excel (.xlsx).",
  no_se_reconocieron_items: "No pudimos reconocer ítems en ese archivo. Prueba con una foto más clara o cárgalos manualmente.",
  fallo_lectura: "Hubo un problema leyendo la carta. Intenta de nuevo en unos minutos.",
};
let error: string | null = ERRORES_SUBIDA[Astro.url.searchParams.get("error") ?? ""] ?? null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const accion = String(form.get("_accion") ?? "");

  if (accion === "continuar") {
    return Astro.redirect("/onboarding/listo");
  }

  if (accion === "crear") {
    const nombre = String(form.get("nombre") ?? "").trim();
    const descripcion = String(form.get("descripcion") ?? "").trim();
    const precioClp = Number(form.get("precio_clp"));

    if (nombre.length === 0) {
      error = "El nombre no puede estar vacío.";
    } else if (!Number.isInteger(precioClp) || precioClp < 0) {
      error = "El precio debe ser un número entero mayor o igual a 0.";
    } else {
      await crearMenuItem(env.DB, negocioId, {
        nombre,
        descripcion: descripcion.length > 0 ? descripcion : null,
        precioClp,
        orden: 0,
      });
    }
  }

  if (!error) return Astro.redirect("/onboarding/menu");
}

const menu = await listarMenu(env.DB, negocioId);
---

<WizardLayout title="Menú" paso={5}>
  <p>
    Carga la carta de <strong>{negocio.nombre}</strong> — puedes subir una foto, un PDF o un
    Excel, o agregar los ítems uno por uno. Si prefieres, también puedes completar esto más
    tarde y seguir con la configuración.
  </p>

  {error && <div class="error">{error}</div>}

  {menu.length > 0 && (
    <table>
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Precio</th>
        </tr>
      </thead>
      <tbody>
        {menu.map((item) => (
          <tr>
            <td>{item.nombre}</td>
            <td>{item.descripcion ?? "—"}</td>
            <td>${item.precio_clp.toLocaleString("es-CL")}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}

  <h2>Subir la carta (foto, PDF o Excel)</h2>
  <p>Sube una o más fotos de tu carta, un PDF, o una planilla Excel, y creamos los ítems automáticamente.</p>
  <form method="POST" enctype="multipart/form-data" action="/onboarding/menu/subir">
    <input
      type="file"
      name="archivos"
      accept="image/*,application/pdf,.xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      multiple
      required
    />
    <button type="submit">Leer carta</button>
  </form>

  <h2>O agregar un ítem manualmente</h2>
  <form method="POST" class="form-grid">
    <input type="hidden" name="_accion" value="crear" />
    <label>
      Nombre
      <input type="text" name="nombre" required />
    </label>
    <label>
      Descripción (opcional)
      <input type="text" name="descripcion" />
    </label>
    <label>
      Precio (CLP)
      <input type="number" name="precio_clp" min="0" required />
    </label>
    <button type="submit">Agregar ítem</button>
  </form>

  <p>
    <form method="POST">
      <input type="hidden" name="_accion" value="continuar" />
      <button type="submit">{menu.length > 0 ? "Continuar" : "Saltar este paso"}</button>
    </form>
  </p>
</WizardLayout>
