---
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import {
  obtenerNegocio,
  listarMenu,
  crearMenuItem,
  eliminarMenuItem,
  cambiarDisponibilidadMenuItem,
} from "../../../lib/db.ts";
import { puedeAdministrarNegocio } from "../../../lib/autorizacion.ts";

const usuario = Astro.locals.usuario;
const negocioId = Number(Astro.params.id);
if (!usuario || !puedeAdministrarNegocio(usuario, negocioId)) {
  return new Response("No autorizado", { status: 403 });
}

const negocio = await obtenerNegocio(env.DB, negocioId);
if (!negocio) {
  return new Response("Negocio no encontrado", { status: 404 });
}
const volverUrl = usuario.rol === "admin" ? "/admin/negocios" : `/negocios/${negocioId}/editar`;

const ERRORES_SUBIDA: Record<string, string> = {
  sin_archivos: "No se recibió ningún archivo.",
  archivos_muy_grandes: "Los archivos son muy pesados en conjunto (máximo 15MB en total). Prueba con menos fotos o de menor resolución.",
  formato_no_soportado: "El formato del archivo no es compatible — solo fotos (JPG, PNG, GIF, WEBP), PDF o Excel (.xlsx).",
  no_se_reconocieron_items: "No pudimos reconocer ítems en ese archivo. Prueba con una foto más clara o cárgalos manualmente.",
  fallo_lectura: "Hubo un problema leyendo la carta. Intenta de nuevo en unos minutos.",
};
let error: string | null = ERRORES_SUBIDA[Astro.url.searchParams.get("error") ?? ""] ?? null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const accion = String(form.get("_accion") ?? "crear");

  if (accion === "eliminar") {
    const menuItemId = Number(form.get("menu_item_id"));
    if (menuItemId) await eliminarMenuItem(env.DB, negocioId, menuItemId);
  } else if (accion === "cambiar_disponibilidad") {
    const menuItemId = Number(form.get("menu_item_id"));
    const disponible = form.get("disponible") === "1";
    if (menuItemId) await cambiarDisponibilidadMenuItem(env.DB, negocioId, menuItemId, disponible);
  } else {
    const nombre = String(form.get("nombre") ?? "").trim();
    const descripcion = String(form.get("descripcion") ?? "").trim();
    const precioClp = Number(form.get("precio_clp"));
    const categoria = String(form.get("categoria") ?? "").trim();

    if (nombre.length === 0) {
      error = "El nombre no puede estar vacío.";
    } else if (!Number.isInteger(precioClp) || precioClp < 0) {
      error = "El precio debe ser un número entero mayor o igual a 0.";
    } else {
      await crearMenuItem(env.DB, negocioId, {
        nombre,
        descripcion: descripcion.length > 0 ? descripcion : null,
        precioClp,
        categoria: categoria.length > 0 ? categoria : null,
        orden: 0,
      });
    }
  }

  if (!error) return Astro.redirect(`/negocios/${negocioId}/menu`);
}

const menu = await listarMenu(env.DB, negocioId);
---

<Layout title={`Menú — ${negocio.nombre}`}>
  <p><a href={volverUrl}>&larr; Volver</a></p>

  {error && <div class="error">{error}</div>}

  {menu.length === 0 && <p>Todavía no hay ítems cargados en el menú de este negocio.</p>}

  {menu.length > 0 && (
    <table>
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Categoría</th>
          <th>Precio</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {menu.map((item) => (
          <tr>
            <td>{item.nombre}</td>
            <td>{item.descripcion ?? "—"}</td>
            <td>{item.categoria ?? "—"}</td>
            <td>${item.precio_clp.toLocaleString("es-CL")}</td>
            <td>{item.disponible ? "Disponible" : <span class="badge-inactivo">No disponible</span>}</td>
            <td>
              <form class="inline" method="POST">
                <input type="hidden" name="_accion" value="cambiar_disponibilidad" />
                <input type="hidden" name="menu_item_id" value={item.id} />
                <input type="hidden" name="disponible" value={item.disponible ? "0" : "1"} />
                <button type="submit">{item.disponible ? "Marcar no disponible" : "Marcar disponible"}</button>
              </form>
              <form class="inline" method="POST">
                <input type="hidden" name="_accion" value="eliminar" />
                <input type="hidden" name="menu_item_id" value={item.id} />
                <button type="submit">Eliminar</button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}

  <h2>Subir la carta (foto, PDF o Excel)</h2>
  <p>Sube una o más fotos de la carta, un PDF, o una planilla Excel, y creamos los ítems automáticamente.</p>
  <form method="POST" enctype="multipart/form-data" action={`/negocios/${negocioId}/menu/subir`}>
    <input
      type="file"
      name="archivos"
      accept="image/*,application/pdf,.xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      multiple
      required
    />
    <button type="submit">Leer carta</button>
  </form>

  <h2>Agregar ítem al menú</h2>
  <form method="POST" class="form-grid">
    <input type="hidden" name="_accion" value="crear" />
    <label>
      Nombre
      <input type="text" name="nombre" required />
    </label>
    <label>
      Descripción (opcional)
      <input type="text" name="descripcion" />
    </label>
    <label>
      Categoría (opcional)
      <input type="text" name="categoria" placeholder="ej. Hamburguesas" />
    </label>
    <label>
      Precio (CLP)
      <input type="number" name="precio_clp" min="0" required />
    </label>
    <button type="submit">Agregar</button>
  </form>
</Layout>
