---
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import { obtenerNegocio, listarCitasProximas, cancelarCitaPorId } from "../../../lib/db.ts";
import { utcToZonedTexto } from "../../../lib/tz.ts";
import { puedeAdministrarNegocio } from "../../../lib/autorizacion.ts";

const usuario = Astro.locals.usuario;
const negocioId = Number(Astro.params.id);
if (!puedeAdministrarNegocio(usuario, negocioId)) {
  return new Response("No autorizado", { status: 403 });
}

const negocio = await obtenerNegocio(env.DB, negocioId);
if (!negocio) {
  return new Response("Negocio no encontrado", { status: 404 });
}
const volverUrl = usuario.rol === "admin" ? "/admin/negocios" : `/negocios/${negocioId}/editar`;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const citaId = Number(form.get("cita_id"));
  if (citaId) await cancelarCitaPorId(env.DB, negocioId, citaId);
  return Astro.redirect(`/negocios/${negocioId}/citas`);
}

const citas = await listarCitasProximas(env.DB, negocioId);
---

<Layout title={`Citas — ${negocio.nombre}`}>
  <p><a href={volverUrl}>&larr; Volver</a></p>

  {citas.length === 0 && <p>No hay citas próximas para este negocio.</p>}

  {citas.length > 0 && (
    <table>
      <thead>
        <tr>
          <th>Fecha y hora</th>
          <th>Cliente</th>
          <th>Teléfono</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {citas.map((c) => (
          <tr>
            <td>{utcToZonedTexto(c.fecha_hora_inicio, negocio.timezone)}</td>
            <td>{c.cliente_nombre ?? "—"}</td>
            <td>{c.cliente_telefono}</td>
            <td>
              {c.estado === "confirmada" ? (
                <span class="badge badge-success">Confirmada</span>
              ) : (
                <span class="badge badge-neutral">Pendiente</span>
              )}
            </td>
            <td>
              <form class="inline" method="POST">
                <input type="hidden" name="cita_id" value={c.id} />
                <button type="submit">Cancelar</button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</Layout>
