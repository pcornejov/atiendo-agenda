---
import { env } from "cloudflare:workers";
import Layout from "../../../../layouts/Layout.astro";
import { obtenerNegocio, listarCitasPorCliente, listarPedidosPorCliente } from "../../../../lib/db.ts";
import { utcToZonedTexto } from "../../../../lib/tz.ts";
import { puedeAdministrarNegocio } from "../../../../lib/autorizacion.ts";

const usuario = Astro.locals.usuario;
const negocioId = Number(Astro.params.id);
if (!usuario || !puedeAdministrarNegocio(usuario, negocioId)) {
  return new Response("No autorizado", { status: 403 });
}

const negocio = await obtenerNegocio(env.DB, negocioId);
if (!negocio) {
  return new Response("Negocio no encontrado", { status: 404 });
}

const telefono = decodeURIComponent(Astro.params.telefono ?? "");
if (!telefono) {
  return new Response("Cliente no encontrado", { status: 404 });
}

const [citas, pedidos] = await Promise.all([
  listarCitasPorCliente(env.DB, negocioId, telefono),
  listarPedidosPorCliente(env.DB, negocioId, telefono),
]);

if (citas.length === 0 && pedidos.length === 0) {
  return new Response("Cliente no encontrado", { status: 404 });
}

const nombre = citas[0]?.cliente_nombre ?? pedidos[0]?.cliente_nombre ?? null;
const volverUrl = citas.length > 0 ? `/negocios/${negocioId}/citas` : `/negocios/${negocioId}/pedidos`;

const CLASE_BADGE_CITA: Record<string, string> = {
  pendiente: "badge-neutral",
  confirmada: "badge-success",
  cancelada: "badge-critical",
  completada: "badge-success",
};
const CLASE_BADGE_PEDIDO: Record<string, string> = {
  pendiente: "badge-neutral",
  confirmado: "badge-success",
  preparando: "badge-neutral",
  listo: "badge-success",
  entregado: "badge-success",
  cancelado: "badge-critical",
};
---

<Layout title={`${nombre ?? telefono} — ${negocio.nombre}`}>
  <p><a href={volverUrl}>&larr; Volver</a></p>

  <p>
    <strong>{nombre ?? "Cliente sin nombre registrado"}</strong><br />
    {telefono}
  </p>

  {citas.length > 0 && (
    <>
      <h2>Citas</h2>
      <table>
        <thead>
          <tr>
            <th>Fecha y hora</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          {citas.map((c) => (
            <tr>
              <td>{utcToZonedTexto(c.fecha_hora_inicio, negocio.timezone)}</td>
              <td><span class={`badge ${CLASE_BADGE_CITA[c.estado] ?? "badge-neutral"}`}>{c.estado}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  {pedidos.length > 0 && (
    <>
      <h2>Pedidos</h2>
      <table>
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Total</th>
            <th>Entrega</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          {pedidos.map((p) => (
            <tr>
              <td>{utcToZonedTexto(p.created_at, negocio.timezone)}</td>
              <td>${p.total_clp.toLocaleString("es-CL")}</td>
              <td>{p.tipo_entrega === "retiro" ? "Retiro" : p.tipo_entrega === "despacho" ? "Despacho" : "—"}</td>
              <td><span class={`badge ${CLASE_BADGE_PEDIDO[p.estado] ?? "badge-neutral"}`}>{p.estado}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}
</Layout>
