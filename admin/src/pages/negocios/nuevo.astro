---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import NegocioForm from "../../components/NegocioForm.astro";
import { crearNegocio } from "../../lib/db.ts";
import { validarNegocioForm, type NegocioFormValores } from "../../lib/validacion.ts";

// Alta manual de un piloto por el administrador. El alta self-service de un
// dueño de negocio pasa por /onboarding, no por acá.
if (Astro.locals.usuario.rol !== "admin") {
  return new Response("No autorizado", { status: 403 });
}

let errores: string[] = [];
let valores: NegocioFormValores = {
  nombre: "",
  telefono_whatsapp: "",
  whatsapp_phone_number_id: "",
  servicio_nombre: "",
  duracion_minutos: "45",
  timezone: "America/Santiago",
};

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  valores = {
    nombre: String(form.get("nombre") ?? ""),
    telefono_whatsapp: String(form.get("telefono_whatsapp") ?? ""),
    whatsapp_phone_number_id: String(form.get("whatsapp_phone_number_id") ?? ""),
    servicio_nombre: String(form.get("servicio_nombre") ?? ""),
    duracion_minutos: String(form.get("duracion_minutos") ?? ""),
    timezone: String(form.get("timezone") ?? ""),
  };

  const validacion = validarNegocioForm(valores);
  if (validacion.ok) {
    const resultado = await crearNegocio(env.DB, validacion.datos);
    if (resultado.ok) {
      // A editar, no a horarios: sin un plan asignado ahí el bot no le
      // responde nada a este negocio todavía (ver arquitectura de módulos).
      return Astro.redirect(`/negocios/${resultado.id}/editar`);
    }
    errores = [resultado.error];
  } else {
    errores = validacion.errores;
  }
}
---

<Layout title="Nuevo negocio">
  <NegocioForm valores={valores} errores={errores} textoBoton="Crear negocio" />
</Layout>
