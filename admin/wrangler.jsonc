{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atiendo-agenda-admin",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Misma base D1 que el Worker del bot (pcornejov/atiendo-agenda), bindeada
  // acá también — este proyecto es un panel admin separado que lee/escribe
  // la misma base, no importa código del bot.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atiendo-agenda-db",
      "database_id": "837af49b-9d1c-4e1d-81f5-6bd26fde96de",
      "migrations_dir": "../migrations"
    }
  ],

  // Login con Google (ver README): GOOGLE_CLIENT_ID no es secreto (viaja en la
  // URL de autorización igual). GOOGLE_CLIENT_SECRET sí es secreto — se
  // configura con `wrangler secret put GOOGLE_CLIENT_SECRET` en prod y en
  // `.dev.vars` en local, no acá. ADMIN_EMAIL decide qué cuenta de Google
  // recibe el rol 'admin' (dueño único de todos los negocios) la primera vez
  // que inicia sesión; el resto de las cuentas nuevas quedan como 'dueno'.
  "vars": {
    "GOOGLE_CLIENT_ID": "55350928413-l31am0mvvl24difehfsbkm165clpttvo.apps.googleusercontent.com",
    "ADMIN_EMAIL": "pablo.cornejo.v@gmail.com",
    // FLOW_API_KEY y FLOW_BASE_URL no son secretos. FLOW_SECRET_KEY sí lo es
    // — `wrangler secret put FLOW_SECRET_KEY` en prod, `.dev.vars` en local.
    // FLOW_BASE_URL: sandbox mientras no haya cuenta de producción de Flow.
    "FLOW_API_KEY": "",
    "FLOW_BASE_URL": "https://sandbox.flow.cl/api"
  }
}
